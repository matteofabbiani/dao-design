{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/editorial/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/website/**",
              "ui_kits/website/home-structures/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Season Mix|Inter|Petrona))/i]",
        "message": "Font not provided by the design system. Available: Season Mix, Inter, Petrona."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookingStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|help|step|total|children|tone|key|ref|className|style|children)$/]",
        "message": "<BookingStep> doesn't accept that prop. Declared props: question, help, step, total, children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookingStep'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|cream)$/]",
        "message": "<BookingStep> tone must be one of 'ink' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|tone|ruleWidth|disabled|onClick|as|href|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, tone, ruleWidth, disabled, onClick, as, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:rule|line|block)$/]",
        "message": "<Button> variant must be one of 'rule' | 'line' | 'block'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|cream)$/]",
        "message": "<Button> tone must be one of 'ink' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<ChoiceOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|note|tone|key|ref|className|style|children)$/]",
        "message": "<FactRow> doesn't accept that prop. Declared props: label, value, note, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:rule|faint)$/]",
        "message": "<FactRow> tone must be one of 'rule' | 'faint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|height|width|scrim|caption|objectPosition|children|key|ref|className|style|children)$/]",
        "message": "<ImageFrame> doesn't accept that prop. Declared props: src, alt, ratio, height, width, scrim, caption, objectPosition, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute[name.name='scrim'] > Literal[value!=/^(?:none|floor|band|both)$/]",
        "message": "<ImageFrame> scrim must be one of 'none' | 'floor' | 'band' | 'both'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|active|onNavigate|markAlign|nextDate|logoSrc|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: tone, active, onNavigate, markAlign, nextDate, logoSrc."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|cream)$/]",
        "message": "<NavBar> tone must be one of 'ink' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:home|story|evening|reserve)$/]",
        "message": "<NavBar> active must be one of 'home' | 'story' | 'evening' | 'reserve'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute[name.name='markAlign'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<NavBar> markAlign must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NextDateTooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|tone|disabled|key|ref|className|style|children)$/]",
        "message": "<NextDateTooltip> doesn't accept that prop. Declared props: children, label, tone, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='NextDateTooltip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|cream)$/]",
        "message": "<NextDateTooltip> tone must be one of 'ink' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperGround'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|children|style|as|key|ref|className|style|children)$/]",
        "message": "<PaperGround> doesn't accept that prop. Declared props: theme, children, style, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperGround'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<PaperGround> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|width|vertical|inset|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: tone, width, vertical, inset."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:rule|faint|ink|image)$/]",
        "message": "<Rule> tone must be one of 'rule' | 'faint' | 'ink' | 'image'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|type|multiline|note|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, onChange, placeholder, type, multiline, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|tel|date)$/]",
        "message": "<TextField> type must be one of 'text' | 'email' | 'tel' | 'date'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
